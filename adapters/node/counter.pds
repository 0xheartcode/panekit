# Drive the Node counter example through the panekit seam (needs node on PATH).
#
#   panedrive run adapters/node/counter.pds --backend pty \
#     --state /tmp/node-counter.json \
#     -- node "$(pwd)/adapters/node/example-counter.js" /tmp/node-counter.json
#
# (The script and state paths are absolute: the pty backend spawns `node` with
# its own working directory, so a relative script path may not resolve.)
#
# It proves the seam is language-agnostic: identical driving script and
# conditions as the Rust counter_tui example, against a Node app.

type inc
press Enter
wait-until count=1 --timeout-ms 4000
type inc
press Enter
wait-until count=2 --timeout-ms 4000
assert last=inc
